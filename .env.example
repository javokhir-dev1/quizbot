# @BotFather dan olingan token
BOT_TOKEN=

# Admin(lar)ning Telegram ID raqamlari, vergul bilan: 123456789,987654321
# O'z ID'ingizni @userinfobot orqali bilib olishingiz mumkin
ADMIN_IDS=

# WebApp'ning tashqi HTTPS manzili (Telegram web_app tugmasi faqat https bilan ishlaydi)
# Lokal test uchun: cloudflared tunnel --url http://localhost:8080
WEBAPP_URL=http://127.0.0.1:8080

PORT=8080
TZ_OFFSET=5

# 1 = brauzerda Telegramsiz test qilish (?dev_user=123 bilan). Ishga tushirishda 0 qiling!
DEV_MODE=0
